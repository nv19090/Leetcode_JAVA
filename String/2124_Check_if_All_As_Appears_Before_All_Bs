class Solution {
    public boolean checkString(String s) {
        int n = s.length();
        int i = 0;
        while (i < n) {
            if (s.charAt(i) != 'a') break;
            i++;
        }
        while (i < n) {
            if (s.charAt(i) != 'b') return false;
            i++;
        }
        return true;
    }
}
